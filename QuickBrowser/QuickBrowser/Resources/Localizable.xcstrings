    "QuickBrowser can intercept links if it's set as the default browser.\n\nChoose QuickBrowser from the list in System Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickBrowser can intercept links if it's set as the default browser.\n\nChoose QuickBrowser from the list in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickBrowser puede interceptar enlaces si está configurado como navegador predeterminado.\n\nSelecciona QuickBrowser de la lista en Ajustes del Sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickBrowser может перехватывать ссылки, если установлен браузером по умолчанию.\n\nВ настройках выберите QuickBrowser из списка."
